# AI Academic Assistant - Environment Variables

PROJECT_NAME="AI Doubt Solver – AI Academic Assistant"
ENVIRONMENT=development
DEBUG=True

# Database (Default uses SQLite async for instant local dev, or PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./academic_assistant.db
# PostgreSQL Example for Railway/Production:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/academic_assistant

# Redis URL
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=True

# Security
JWT_SECRET=super-secret-production-grade-key-ai-doubt-solver-2026-x99
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI / Groq API (Enter your Groq key here)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Allowed CORS Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
